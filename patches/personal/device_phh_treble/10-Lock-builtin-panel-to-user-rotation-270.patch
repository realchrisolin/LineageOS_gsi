From 5088ac6e0ef7e8b55d59c827e56a5ea1cf4c181c Mon Sep 17 00:00:00 2001
From: Chris Olin <contact@chrisolin.com>
Date: Sun, 4 Oct 2026 22:41:54 -0400
Subject: [PATCH] Lock the builtin panel to user rotation 270

The watch is worn sideways. A new settings database comes up at
rotation 270, and the panel stays fixed to that rotation when an
app asks for portrait.
---
 base.mk                                       |  3 ++-
 display_settings.xml                          | 10 +++++++++
 .../SettingsProvider/res/values/defaults.xml  | 22 +++++++++++++++++++
 3 files changed, 34 insertions(+), 1 deletion(-)
 create mode 100644 display_settings.xml
 create mode 100644 overlay/frameworks/base/packages/SettingsProvider/res/values/defaults.xml

diff --git a/base.mk b/base.mk
index 553d5a5..317e02a 100644
--- a/base.mk
+++ b/base.mk
@@ -15,7 +15,8 @@ PRODUCT_PACKAGES += \
 
 PRODUCT_COPY_FILES += \
     device/phh/treble/bluetooth/audio/config/sysbta_audio_policy_configuration.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/sysbta_audio_policy_configuration.xml \
-    device/phh/treble/bluetooth/audio/config/sysbta_audio_policy_configuration_7_0.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/sysbta_audio_policy_configuration_7_0.xml
+    device/phh/treble/bluetooth/audio/config/sysbta_audio_policy_configuration_7_0.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/sysbta_audio_policy_configuration_7_0.xml \
+    device/phh/treble/display_settings.xml:$(TARGET_COPY_OUT_PRODUCT)/etc/display_settings.xml
 
 SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += device/phh/treble/sepolicy
 PRODUCT_PACKAGE_OVERLAYS += device/phh/treble/overlay
diff --git a/display_settings.xml b/display_settings.xml
new file mode 100644
index 0000000..3edb059
--- /dev/null
+++ b/display_settings.xml
@@ -0,0 +1,10 @@
+<?xml version='1.0' encoding='utf-8' standalone='yes' ?>
+<!--
+  Builtin panel, matched by port. fixedToUserRotation 2 is
+  FIXED_TO_USER_ROTATION_ENABLED: an app that asks for portrait does not
+  turn the panel.
+-->
+<display-settings>
+    <config identifier="1" />
+    <display name="port:0" fixedToUserRotation="2" />
+</display-settings>
diff --git a/overlay/frameworks/base/packages/SettingsProvider/res/values/defaults.xml b/overlay/frameworks/base/packages/SettingsProvider/res/values/defaults.xml
new file mode 100644
index 0000000..e257f76
--- /dev/null
+++ b/overlay/frameworks/base/packages/SettingsProvider/res/values/defaults.xml
@@ -0,0 +1,22 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+ * Copyright (c) 2026, The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+-->
+<resources>
+    <!-- Natural panel is 480x640. This watch is worn at rotation 270, so a
+         new settings database comes up landscape. Auto-rotate stays at its
+         default of off. -->
+    <integer name="def_user_rotation">3</integer>
+</resources>
-- 
