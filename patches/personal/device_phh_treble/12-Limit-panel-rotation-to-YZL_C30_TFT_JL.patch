From 903b416a9864407c7496011b83477c5de43b32ae Mon Sep 17 00:00:00 2001
From: Chris Olin <contact@chrisolin.com>
Date: Mon, 5 Oct 2026 20:16:12 -0400
Subject: [PATCH] Fix panel rotation on LOKMAT APPLLP 9 MAX

[device] The builtin panel is 480x640 and the watch is worn at
rotation 270. A product display_settings.xml and a SettingsProvider
overlay rotate every phone that boots this GSI.

phh-on-data.sh writes /data/system/display_settings.xml only when
ro.vendor.build.fingerprint is alps/vnd_YZL_C30_TFT_JL/YZL_C30_TFT_JL,
and only when that file is absent. Window Manager keeps a later size
or density override. A factory reset removes the file and the next
boot writes it again.

fixedToUserRotation 2 is FIXED_TO_USER_ROTATION_ENABLED. The default
angle is the fingerprint SettingsProvider overlay. DisplayRotation
returns before applying userRotation from this file on the default
display.
---
 base.mk                                       |  3 +-
 display_settings.xml                          | 10 ------
 .../SettingsProvider/res/values/defaults.xml  | 22 -------------
 phh-on-data.sh                                | 33 +++++++++++++++++++
 4 files changed, 34 insertions(+), 34 deletions(-)
 delete mode 100644 display_settings.xml
 delete mode 100644 overlay/frameworks/base/packages/SettingsProvider/res/values/defaults.xml

diff --git a/base.mk b/base.mk
index e40f464..8100407 100644
--- a/base.mk
+++ b/base.mk
@@ -15,8 +15,7 @@ PRODUCT_PACKAGES += \
 
 PRODUCT_COPY_FILES += \
     device/phh/treble/bluetooth/audio/config/sysbta_audio_policy_configuration.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/sysbta_audio_policy_configuration.xml \
-    device/phh/treble/bluetooth/audio/config/sysbta_audio_policy_configuration_7_0.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/sysbta_audio_policy_configuration_7_0.xml \
-    device/phh/treble/display_settings.xml:$(TARGET_COPY_OUT_PRODUCT)/etc/display_settings.xml
+    device/phh/treble/bluetooth/audio/config/sysbta_audio_policy_configuration_7_0.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/sysbta_audio_policy_configuration_7_0.xml
 
 SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += device/phh/treble/sepolicy
 PRODUCT_PACKAGE_OVERLAYS += device/phh/treble/overlay
diff --git a/display_settings.xml b/display_settings.xml
deleted file mode 100644
index 3edb059..0000000
--- a/display_settings.xml
+++ /dev/null
@@ -1,10 +0,0 @@
-<?xml version='1.0' encoding='utf-8' standalone='yes' ?>
-<!--
-  Builtin panel, matched by port. fixedToUserRotation 2 is
-  FIXED_TO_USER_ROTATION_ENABLED: an app that asks for portrait does not
-  turn the panel.
--->
-<display-settings>
-    <config identifier="1" />
-    <display name="port:0" fixedToUserRotation="2" />
-</display-settings>
diff --git a/overlay/frameworks/base/packages/SettingsProvider/res/values/defaults.xml b/overlay/frameworks/base/packages/SettingsProvider/res/values/defaults.xml
deleted file mode 100644
index e257f76..0000000
--- a/overlay/frameworks/base/packages/SettingsProvider/res/values/defaults.xml
+++ /dev/null
@@ -1,22 +0,0 @@
-<?xml version="1.0" encoding="utf-8"?>
-<!--
